{
  "id": "prop_lowpoly",
  "kind": "asset",
  "title": "Low-poly prop",
  "description": "Weapons, furniture, pickups, scenery. About 3,000 triangles with a baked normal map and 2K PBR textures. Tuned and verified on a 16 GB card.",
  "status": "tested",
  "image_profile": "concept_prop",
  "graph": "../workflows/lowpoly_prop_ultratex.json",
  "vram_group": "mesh",
  "min_vram_gb": 8,

  "params": {
    "tris": 3000,
    "thin": 0.6,
    "voxel_size": 0.005,
    "lowpoly_passes": 6,
    "highpoly_faces": 1200000,
    "trellis": true,
    "shape_resolution": 1024,
    "quad_resolution": 1024,
    "components": "keep_all",
    "tiled_decode": false,
    "clean_ram": false
  },
  "param_help": {
    "tris": "triangle budget of the final mesh",
    "thin": "0.0-1.0, thickens thin parts before clean-up; raise to 0.8-0.9 for poles, blades, chains",
    "voxel_size": "low-poly rebuild grid; 0.0015 shatters thin props, 0.005 is safe",
    "trellis": "true = TRELLIS.2 (upright, true 3D); false = Pixal3D (follows the picture's camera, can flatten or tilt)",
    "highpoly_faces": "size of the high-poly mesh the normal map is baked from (trimmed on the GPU)",
    "shape_resolution": "voxel resolution of the high-poly shape: 1024 or 1536. Measured on one prop: 1536 took 810 s, 1024 took 322 s, with no visible difference at 3,000 triangles",
    "quad_resolution": "512 / 1024 / 1536; 1536 runs out of memory on 16 GB",
    "components": "keep_all keeps separate parts; largest drops everything but the biggest piece"
  },

  "set": {
    "122.image": "{image_file}",
    "316.value": "{trellis}",
    "314.switch": "{trellis}",
    "315.switch": "{trellis}",
    "318.switch": "{trellis}",
    "94.target_resolution": "{shape_resolution}",
    "325.resolution": "{quad_resolution}",
    "327.thin_iso_vox": "{thin}",
    "327.faithc_component_mode": "{components}",
    "335.blender_path": "{blender}",
    "335.target_tris": "{tris}",
    "335.passes": "{lowpoly_passes}",
    "335.relative_voxel_size": "{voxel_size}",
    "342.max_attempts": 1,
    "358.tiled_decode": "{tiled_decode}",
    "364.tiled_decode": "{tiled_decode}",
    "326.clean_ram": "{clean_ram}",
    "340.clean_ram": "{clean_ram}",
    "383.clean_ram": "{clean_ram}"
  },
  "replace_nodes": {
    "328": {
      "class_type": "CuMeshGeometryDecimate",
      "inputs": {
        "mesh": ["327", 0],
        "target_faces": "{highpoly_faces}",
        "initial_threshold": 1e-8,
        "edge_length_weight": 0.01,
        "skinny_triangle_weight": 0.001,
        "unload_models": false,
        "output_smooth_normals": true,
        "verbose": false
      }
    }
  },
  "seed_inputs": ["3.seed", "18.seed", "23.seed"],

  "outputs": {
    "glb": {"node": "386", "ext": ".glb"},
    "lowpoly_untextured": {"node": "343", "ext": ".glb", "keep": false},
    "utx": {"node": "361", "ext": ".glb", "keep": false},
    "base_color": {"node": "362", "ext": ".png"},
    "roughness": {"node": "366", "ext": ".png"},
    "metallic": {"node": "367", "ext": ".png"}
  },
  "primary_output": "glb",

  "check": {"enabled": true, "target_param": "tris"},
  "retry": {"attempts": 1, "reseed": true, "add": {"thin": 0.2}},

  "tiers": {
    "8":  {"params": {"tiled_decode": true, "clean_ram": true, "quad_resolution": 512, "shape_resolution": 1024}},
    "12": {"params": {"tiled_decode": true, "quad_resolution": 1024, "shape_resolution": 1024}},
    "24": {"params": {"quad_resolution": 1536, "shape_resolution": 1536}}
  }
}
