{
  "id": "character_lowpoly",
  "extends": "prop_lowpoly",
  "title": "Low-poly character",
  "description": "A full-body character at about 12,000 triangles, in an A-pose, ready for auto-rigging. Hold weapons and items as separate props.",
  "status": "tested",
  "image_profile": "concept_character",
  "graph": "../workflows/lowpoly_character_ultratex.json",
  "params": {
    "tris": 12000,
    "thin": 0.0,
    "voxel_size": 0.0015,
    "lowpoly_passes": 3
  },
  "retry": {
    "attempts": 1,
    "reseed": true,
    "add": {
      "thin": 0.3
    }
  },
  "presets": {
    "fast": {
      "params": {
        "tris": 4000,
        "lowpoly_passes": 4
      }
    },
    "max": {
      "description": "Split generation: the body is built at full resolution, the head is isolated and built on its own so the face gets a whole model's worth of detail, and the two are fitted together automatically.",
      "params": {
        "tris": 12000,
        "lowpoly_passes": 3,
        "shape_resolution": 1536,
        "texture_steps": 8,
        "texture_extra_steps": 8
      },
      "split": {
        "parts": [
          {
            "id": "head",
            "isolate_profile": "isolate_head",
            "part_profile": "part_lowpoly",
            "params": {
              "tris": 4500,
              "texture_steps": 8,
              "texture_extra_steps": 8
            }
          }
        ]
      }
    }
  }
}