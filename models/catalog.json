  "hardware_guide": {
    "_about": "Only the 16 GB column has been measured (RTX 5080). The other tiers are starting points taken from how the original workflows were tuned for small cards; verify on the actual machine.",
    "8": {
      "summary": "Works, slowly. Everything must be unloaded between stages.",
      "profiles": "prop_lowpoly and character_lowpoly run with tiled decoding, RAM cleaning, shape resolution 1024 and quad resolution 512 (applied automatically).",
      "models": "Use the Q4 GGUF text encoder (Qwen3-8B-Q4_K_M.gguf). Qwen-Image 2.1 needs about 12 GB for image generation; on 8 GB supply your own concept images (image=...) or add a lighter image profile.",
      "measured": false
    },
    "12": {
      "summary": "All built-in profiles run; image generation is tight.",
      "profiles": "Tiled decoding stays on, shape resolution 1024 (applied automatically).",
      "models": "Q4 GGUF text encoder. int8 Qwen-Image 2.1 fits with offloading.",
      "measured": false
    },
    "16": {
      "summary": "The reference machine. Everything runs with the settings in the profiles.",
      "profiles": "No tiling, weights kept in RAM between assets, quad resolution 1024 (1536 runs out of memory).",
      "models": "int8 diffusion models, Q4 or Q6 GGUF text encoder.",
      "measured": true
    },
    "24": {
      "summary": "Headroom for higher resolutions.",
      "profiles": "Quad resolution 1536 is enabled automatically. Try prop_hero / higher triangle budgets.",
      "models": "The fp8mixed text encoder (qwen_3_8b_fp8mixed.safetensors) and non-quantised diffusion models become practical; add them as new profiles.",
      "measured": false
    }
  },
